{
  "name": "@lapangango/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit -p tsconfig.json --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check src test drizzle.config.ts package.json tsconfig*.json",
    "test": "vitest run --exclude test/integration/** --exclude test/security/** --exclude test/concurrency/**",
    "test:integration": "vitest run test/integration --pool forks --maxWorkers 1",
    "test:security": "vitest run test/security",
    "test:concurrency": "vitest run test/concurrency --pool forks --maxWorkers 1",
    "test:b2:unit": "vitest run src/finance/domain/calculateFinancialSnapshot.test.ts src/booking/domain/cancellationPolicy.test.ts",
    "test:b2:integration": "vitest run test/integration/b2DomainFlows.test.ts --pool forks --maxWorkers 1",
    "test:b2:security": "vitest run test/security/tenantIsolation.test.ts --pool forks --maxWorkers 1",
    "test:b2:concurrency": "vitest run test/concurrency/promotionQuota.test.ts --pool forks --maxWorkers 1",
    "test:docs": "vitest run test/documentation",
    "test:migrations": "vitest run test/migration",
    "test:tidb": "tsx src/database/verifyCompatibility.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@aws-sdk/s3-request-presigner": "^3.1119.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.10",
    "mysql2": "^3.24.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
