{
  "name": "@lapangango/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../docs/openapi/b1.yaml -o src/generated.ts",
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit -p tsconfig.json --pretty false",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:contract": "vitest run src/contract.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
