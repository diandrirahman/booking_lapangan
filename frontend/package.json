{
  "name": "@lapangango/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "type-check": "tsc --noEmit -p tsconfig.app.json --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check src e2e playwright.config.ts package.json docs",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "test:e2e": "cross-env VITE_SERVER_STATE=off playwright test --config playwright.config.ts",
    "test:e2e:b1": "playwright test --config playwright.b1.config.ts",
    "test:manual:b1": "playwright test --config playwright.manual-b1.config.ts",
    "test:ui-audit": "cross-env VITE_SERVER_STATE=off playwright test --config playwright.ui-audit.config.ts",
    "qa": "npm run format:check && npm run lint && npm run type-check && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@lapangango/api-client": "file:../packages/api-client",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-table": "^9.1.2",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "latest",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.34.0",
    "react": "latest",
    "react-day-picker": "^10.0.1",
    "react-dom": "latest",
    "react-hook-form": "^7.86.0",
    "react-router-dom": "latest",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vite": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "latest",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3"
  }
}
